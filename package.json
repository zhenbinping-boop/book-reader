{
  "name": "book-reader",
  "private": true,
  "version": "0.3.0-alpha.4",
  "type": "module",
  "scripts": {
    "postinstall": "node tools/patch_inappbrowser.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predev": "node tools/copy_pdf_assets.mjs",
    "prebuild": "node tools/patch_inappbrowser.mjs && node tools/copy_pdf_assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:acceptance": "python tools/run_acceptance.py",
    "test:mobile": "python tools/run_acceptance.py --page dev-mobile-acceptance.html",
    "test:book-browser": "python tools/run_acceptance.py --page dev-book-browser.html",
    "prebuild:android": "node tools/patch_inappbrowser.mjs && node tools/copy_pdf_assets.mjs",
    "build:android": "vite build --mode android",
    "prebuild:native": "node tools/patch_inappbrowser.mjs && node tools/copy_pdf_assets.mjs",
    "build:native": "vite build --mode native",
    "ios:sync": "npm run build:native && cap sync ios",
    "android:sync": "npm run build:android && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "icons": "node tools/make_icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-inappbrowser": "8.26.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
